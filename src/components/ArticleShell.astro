---
// Layout reutilizable para artículos/guías: breadcrumb, cabecera con autor/fecha,
// tabla de contenidos y caja de fuentes. Usá <slot /> para el cuerpo.
import { SITE } from '../data/site.js';
const { title, category, readTime, updated, author = 'Equipo editorial EmprendeUS', toc = [], sources = [] } = Astro.props;
---
<article class="art container">
  <nav class="crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a> <span aria-hidden="true">›</span>
    <a href="/guias">Guías</a> <span aria-hidden="true">›</span>
    <span class="crumbs__current">{category}</span>
  </nav>

  <header class="art__head">
    <span class="tag">{category}</span>
    <h1 class="art__title">{title}</h1>
    <div class="art__byline">
      <span>Por <strong>{author}</strong></span>
      <span aria-hidden="true">·</span>
      <span>Actualizado {updated}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </header>

  <div class="art__layout">
    <div class="art__body">
      {toc.length > 0 && (
        <nav class="toc" aria-label="Tabla de contenidos">
          <div class="toc__title">En esta guía</div>
          <ol>
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
          </ol>
        </nav>
      )}
      <slot />

      {sources.length > 0 && (
        <section class="sources-box" aria-label="Fuentes">
          <h2>Fuentes oficiales</h2>
          <ul>
            {sources.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener nofollow">{s.label}</a></li>
            ))}
          </ul>
          <p class="sources-box__note">Datos verificados el {SITE.updatedLabel}. Las tarifas y reglas del IRS y de los estados cambian; confirmá siempre en la fuente oficial antes de decidir.</p>
        </section>
      )}
    </div>
  </div>
</article>

<style>
  .art { padding: 40px 32px 72px; max-width: 820px; }
  .crumbs { font-size: 13px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .crumbs a { color: var(--text-3); }
  .crumbs a:hover { color: var(--bg-emerald); }
  .crumbs__current { color: var(--text); }

  .tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--badge-text); background: var(--badge-bg); padding: 4px 10px; border-radius: 6px;
  }
  .art__title {
    font-weight: 800; font-size: 44px; line-height: 1.08; letter-spacing: -0.02em;
    margin: 16px 0 18px; color: var(--text); text-wrap: balance;
  }
  .art__byline { display: flex; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--text-3); padding-bottom: 28px; border-bottom: 1px solid var(--border); }
  .art__byline strong { color: var(--text-2); }

  .toc { background: var(--bg-neutral); border-radius: 14px; padding: 22px 26px; margin: 32px 0; }
  .toc__title { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--success); margin-bottom: 12px; }
  .toc ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .toc a { font-size: 15px; color: var(--text-2); }
  .toc a:hover { color: var(--bg-emerald); }

  .sources-box { margin-top: 48px; padding: 24px 26px; background: #fff; border: 1px solid var(--border); border-radius: 14px; }
  .sources-box h2 { font-size: 18px; margin: 0 0 14px; }
  .sources-box ul { margin: 0 0 14px; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
  .sources-box__note { font-size: 12.5px; color: var(--text-3); margin: 0; line-height: 1.6; }

  @media (max-width: 560px) {
    .art__title { font-size: 31px; }
  }
</style>

<style is:global>
  /* Tipografía del cuerpo del artículo */
  .art__body > h2 {
    font-weight: 700; font-size: 28px; line-height: 1.2; letter-spacing: -0.01em;
    margin: 44px 0 14px; color: var(--text); scroll-margin-top: 120px;
  }
  .art__body > h3 { font-weight: 700; font-size: 20px; margin: 28px 0 10px; color: var(--text); scroll-margin-top: 120px; }
  .art__body > p { font-size: 17px; line-height: 1.7; color: #2c3733; margin: 0 0 18px; }
  .art__body > p a, .art__body li a { color: var(--badge-text); text-decoration: underline; text-underline-offset: 2px; }
  .art__body > ul, .art__body > ol { font-size: 17px; line-height: 1.7; color: #2c3733; margin: 0 0 18px; padding-left: 24px; }
  .art__body > ul li, .art__body > ol li { margin-bottom: 8px; }
  .art__body strong { color: var(--text); }

  .callout {
    display: flex; gap: 14px; padding: 20px 22px; border-radius: 14px; margin: 26px 0;
    font-size: 15.5px; line-height: 1.6;
  }
  .callout__icon { font-size: 20px; flex-shrink: 0; line-height: 1.3; }
  .callout p { margin: 0; }
  .callout--warn { background: #fdf1ef; border: 1px solid #f2d4cf; color: #6b3b35; }
  .callout--info { background: #eef9f2; border: 1px solid #d6ecdf; color: #1f4a38; }
  .callout--tip { background: var(--bg-neutral); border: 1px solid var(--border); color: var(--text-2); }

  .art-table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 15px; }
  .art-table th, .art-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--border); }
  .art-table th { background: var(--bg-neutral); font-weight: 600; color: var(--text); }
  .art-table-wrap { overflow-x: auto; }
</style>
