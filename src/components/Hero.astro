---
import { HERO_STATS, STATES, STATE_ORDER } from '../data/site.js';
const statesJson = JSON.stringify(STATES);
const first = STATES[STATE_ORDER[0]];
---
<section class="hero container">
  <div class="hero__copy">
    <div class="pill">
      <span class="pill__dot" aria-hidden="true"></span>
      Actualizado para la temporada fiscal 2026
    </div>
    <h1 class="hero__title">Abre y gestiona tu LLC en EE.&nbsp;UU. sin complicaciones ni sobrecostos</h1>
    <p class="hero__sub">
      Guías claras en español, comparativas honestas y herramientas de cálculo para no residentes que
      quieren formar su empresa, sacar el EIN sin SSN y abrir cuenta bancaria en Estados Unidos.
    </p>
    <div class="hero__ctas">
      <a href="#quiz" class="btn btn-primary hero__cta">Iniciar mi diagnóstico gratis</a>
      <a href="#comparador" class="btn btn-ghost hero__cta">Comparar servicios de LLC</a>
    </div>
    <div class="hero__stats">
      {HERO_STATS.map((s) => (
        <div>
          <div class="hero__stat-val">{s.value}</div>
          <div class="hero__stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Calculadora -->
  <div class="calc-wrap">
    <div class="calc" data-calc data-states={statesJson}>
      <div class="calc__glow" aria-hidden="true"></div>
      <span class="calc__eyebrow">Calculadora rápida</span>
      <h2 class="calc__title">Costo de LLC por estado</h2>

      <label class="calc__label" for="calc-state">Elige tu estado de registro</label>
      <div class="calc__select-wrap">
        <select id="calc-state" class="calc__select" data-calc-select>
          {STATE_ORDER.map((k) => (
            <option value={k}>{STATES[k].name}</option>
          ))}
        </select>
        <span class="calc__select-caret" aria-hidden="true">▾</span>
      </div>

      <div class="calc__cards">
        <div class="calc__card">
          <div class="calc__card-label">Registro estatal</div>
          <div class="calc__card-val calc__card-val--accent" data-calc-reg>{first.reg}</div>
          <div class="calc__card-note">pago único</div>
        </div>
        <div class="calc__card">
          <div class="calc__card-label">Reporte anual</div>
          <div class="calc__card-val" data-calc-annual>{first.annual}</div>
          <div class="calc__card-note" data-calc-annual-note>{first.annualNote}</div>
        </div>
      </div>

      <div class="calc__tip">
        <span aria-hidden="true">◆</span>
        <p data-calc-tip>{first.tip}</p>
      </div>
      <p class="calc__disclaimer">Tarifas estatales referenciales · verificadas jul 2026 · no incluye honorarios de agente</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 32px 40px;
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center;
  }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px;
    border: 1px solid #dcefe4; background: #eef9f2; border-radius: 999px;
    font-size: 12px; font-weight: 600; color: var(--badge-text); margin-bottom: 24px;
  }
  .pill__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
  .hero__title {
    font-weight: 700; font-size: 56px; line-height: 1.04; letter-spacing: -0.02em;
    margin: 0 0 22px; color: var(--text); text-wrap: balance;
  }
  .hero__sub {
    font-size: 18px; line-height: 1.6; color: var(--text-2); margin: 0 0 32px;
    max-width: 520px; text-wrap: pretty;
  }
  .hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .hero__cta { font-size: 15px; padding: 14px 26px; }
  .hero__stats { display: flex; align-items: center; gap: 24px; margin-top: 36px; }
  .hero__stat-val { font-family: var(--font-head); font-weight: 700; font-size: 26px; color: var(--bg-emerald); }
  .hero__stat-label { font-size: 12.5px; color: var(--text-3); margin-top: 2px; }

  .calc-wrap { animation: euFade 0.6s ease both; }
  .calc {
    background: var(--bg-emerald); border-radius: 20px; padding: 28px;
    box-shadow: var(--shadow-calc); position: relative; overflow: hidden;
  }
  .calc__glow {
    position: absolute; top: -60px; right: -60px; width: 180px; height: 180px;
    background: radial-gradient(circle, rgba(167, 232, 196, 0.18), transparent 70%);
  }
  .calc__eyebrow {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em;
    text-transform: uppercase; color: #7fcba3; position: relative;
  }
  .calc__title {
    font-family: var(--font-head); font-weight: 600; font-size: 23px; color: var(--on-dark);
    margin: 4px 0 20px; position: relative;
  }
  .calc__label { display: block; font-size: 12.5px; font-weight: 500; color: #9fc5b4; margin-bottom: 8px; }
  .calc__select-wrap { position: relative; margin-bottom: 22px; }
  .calc__select {
    width: 100%; padding: 14px 16px; border-radius: 12px;
    border: 1px solid rgba(167, 232, 196, 0.25); background: rgba(255, 255, 255, 0.08);
    color: var(--on-dark); font-size: 15px; font-weight: 500; font-family: inherit;
    outline: none; appearance: none; cursor: pointer;
  }
  .calc__select option { color: #0a192f; }
  .calc__select-caret { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #7fcba3; pointer-events: none; font-size: 11px; }
  .calc__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .calc__card {
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(167, 232, 196, 0.15);
    border-radius: 12px; padding: 16px;
  }
  .calc__card-label { font-size: 11.5px; color: #8fb8a5; margin-bottom: 6px; }
  .calc__card-val { font-family: var(--font-head); font-weight: 700; font-size: 28px; color: var(--on-dark); }
  .calc__card-val--accent { color: var(--cta); }
  .calc__card-note { font-size: 11px; color: #6e9585; margin-top: 3px; }
  .calc__tip {
    display: flex; align-items: flex-start; gap: 8px; padding: 12px 14px;
    background: rgba(167, 232, 196, 0.08); border-radius: 10px;
  }
  .calc__tip span { color: var(--cta); font-size: 13px; line-height: 1.4; }
  .calc__tip p { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--on-dark-2); }
  .calc__disclaimer { font-family: var(--font-mono); font-size: 10px; color: #5c7f70; margin-top: 14px; text-align: center; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 48px; }
    .hero__title { font-size: 40px; }
    .hero__sub { font-size: 16.5px; }
  }
  @media (max-width: 480px) {
    .hero__title { font-size: 33px; }
    .hero__stats { gap: 16px; }
    .hero__stat-val { font-size: 22px; }
  }
</style>

<script>
  document.querySelectorAll('[data-calc]').forEach((el) => {
    const states = JSON.parse(el.getAttribute('data-states'));
    const select = el.querySelector('[data-calc-select]');
    const reg = el.querySelector('[data-calc-reg]');
    const annual = el.querySelector('[data-calc-annual]');
    const annualNote = el.querySelector('[data-calc-annual-note]');
    const tip = el.querySelector('[data-calc-tip]');
    select?.addEventListener('change', (e) => {
      const s = states[e.target.value];
      if (!s) return;
      reg.textContent = s.reg;
      annual.textContent = s.annual;
      annualNote.textContent = s.annualNote;
      tip.textContent = s.tip;
    });
  });
</script>
