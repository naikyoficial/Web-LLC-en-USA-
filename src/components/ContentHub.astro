---
import { FEATURED_ARTICLE, ARTICLES } from '../data/site.js';
import AdSlot from './AdSlot.astro';
---
<section id="guias" class="container hub">
  <div class="hub__grid">
    <div class="hub__main">
      <div class="section-head hub__head">
        <span class="eyebrow">Guías pilares</span>
        <h2 class="section-title">Aprende a moverte en el sistema de EE.&nbsp;UU.</h2>
      </div>

      <!-- Artículo destacado -->
      <a href={FEATURED_ARTICLE.href} class="feature">
        <div class="feature__img" aria-hidden="true">
          <span class="ph-label">{FEATURED_ARTICLE.imgLabel}</span>
        </div>
        <div class="feature__body">
          <div class="feature__meta">
            <span class="tag">{FEATURED_ARTICLE.category}</span>
            <span class="meta-dim">{FEATURED_ARTICLE.readTime}</span>
            <span class="meta-dim">· {FEATURED_ARTICLE.updated}</span>
          </div>
          <h3 class="feature__title">{FEATURED_ARTICLE.title}</h3>
          <p class="feature__excerpt">{FEATURED_ARTICLE.excerpt}</p>
        </div>
      </a>

      <AdSlot label="Publicidad Patrocinada · In-Feed Ad Unit" height="120px" />

      <div class="hub__cards">
        {ARTICLES.map((a) => (
          <a href={a.href} class="acard">
            <div class="acard__img" aria-hidden="true"><span class="ph-label">{a.imgLabel}</span></div>
            <div class="acard__body">
              <div class="acard__meta">
                <span class="tag tag--sm">{a.category}</span>
                <span class="meta-dim">{a.readTime}</span>
              </div>
              <h3 class="acard__title">{a.title}</h3>
              <p class="acard__updated">Actualizado {a.updated}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="hub__side">
      <AdSlot label="Publicidad Patrocinada" size="300×600" height="600px" />
      <div class="newsletter">
        <div class="newsletter__title">Newsletter fiscal</div>
        <p class="newsletter__desc">Cambios del IRS y los estados, cada quincena en tu correo.</p>
        <form data-newsletter>
          <label class="sr-only" for="nl-email">Tu correo electrónico</label>
          <input id="nl-email" type="email" required placeholder="tu@correo.com" class="newsletter__input" />
          <button type="submit" class="newsletter__btn">Suscribirme gratis</button>
          <p class="newsletter__msg" data-newsletter-msg hidden>¡Gracias! Revisá tu correo para confirmar.</p>
        </form>
      </div>
    </aside>
  </div>
</section>

<style>
  .hub { padding: 76px 32px; }
  .hub__grid { display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: start; }
  .hub__head { margin-bottom: 34px; max-width: none; }
  .hub__head .section-title { margin-top: 12px; font-size: 38px; }

  .ph-label { font-family: var(--font-mono); font-size: 11px; color: #a8a498; }
  .tag {
    font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--badge-text); background: var(--badge-bg); padding: 4px 10px; border-radius: 6px;
  }
  .tag--sm { font-size: 10.5px; padding: 4px 9px; }
  .meta-dim { font-size: 12.5px; color: var(--text-4); }

  .feature {
    display: block; border: 1px solid var(--border); border-radius: var(--radius-card);
    overflow: hidden; background: #fff; margin-bottom: 26px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .feature:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(10, 25, 15, 0.18); }
  .feature__img {
    height: 240px; display: flex; align-items: center; justify-content: center;
    background: repeating-linear-gradient(135deg, #edece6, #edece6 14px, #e7e5de 14px, #e7e5de 28px);
  }
  .feature__body { padding: 26px 28px 28px; }
  .feature__meta { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .feature__title { font-weight: 700; font-size: 27px; line-height: 1.2; margin: 0 0 10px; color: var(--text); }
  .feature__excerpt { font-size: 15px; line-height: 1.6; color: var(--text-2); margin: 0; }

  .hub__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .acard {
    display: block; border: 1px solid var(--border); border-radius: 16px; overflow: hidden;
    background: #fff; height: 100%; transition: transform 0.2s, box-shadow 0.2s;
  }
  .acard:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgba(10, 25, 15, 0.18); }
  .acard__img {
    height: 150px; display: flex; align-items: center; justify-content: center;
    background: repeating-linear-gradient(135deg, #edece6, #edece6 12px, #e7e5de 12px, #e7e5de 24px);
  }
  .acard__body { padding: 20px 22px 22px; }
  .acard__meta { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .acard__title { font-weight: 700; font-size: 19px; line-height: 1.25; margin: 0 0 8px; color: var(--text); }
  .acard__updated { font-size: 13px; color: var(--text-4); margin: 0; }

  .hub__side { position: sticky; top: 180px; display: flex; flex-direction: column; gap: 22px; }
  .newsletter { background: var(--bg-emerald); border-radius: 16px; padding: 24px; }
  .newsletter__title { font-family: var(--font-head); font-weight: 600; font-size: 19px; color: var(--on-dark); margin-bottom: 8px; }
  .newsletter__desc { font-size: 13px; line-height: 1.5; color: var(--on-dark-3); margin: 0 0 16px; }
  .newsletter__input {
    width: 100%; padding: 11px 13px; border-radius: 10px; border: 1px solid rgba(167, 232, 196, 0.2);
    background: rgba(255, 255, 255, 0.06); color: var(--on-dark); font-size: 13.5px;
    font-family: inherit; margin-bottom: 10px; outline: none;
  }
  .newsletter__input::placeholder { color: #7c9a8c; }
  .newsletter__btn {
    width: 100%; padding: 11px; border-radius: 10px; border: none; background: var(--cta);
    color: var(--cta-text); font-size: 13.5px; font-weight: 600; cursor: pointer; font-family: inherit;
  }
  .newsletter__msg { font-size: 12.5px; color: var(--cta); margin: 10px 0 0; }

  @media (max-width: 900px) {
    .hub__grid { grid-template-columns: 1fr; gap: 40px; }
    .hub__side { position: static; flex-direction: row; flex-wrap: wrap; }
    .hub__side > * { flex: 1; min-width: 260px; }
    .hub__head .section-title { font-size: 28px; }
  }
  @media (max-width: 560px) {
    .hub__cards { grid-template-columns: 1fr; }
    .feature__title { font-size: 22px; }
  }
</style>

<script>
  document.querySelectorAll('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const msg = form.querySelector('[data-newsletter-msg]');
      // TODO: conectar con tu proveedor de email (Mailchimp, ConvertKit, Beehiiv…)
      if (msg) msg.hidden = false;
      form.querySelector('input')?.setAttribute('disabled', 'true');
    });
  });
</script>
