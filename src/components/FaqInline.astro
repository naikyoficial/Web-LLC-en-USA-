---
// Acordeón de FAQ reutilizable para artículos. Recibe `faqs: [{q, a}]`.
const { faqs = [], heading } = Astro.props;
---
{heading && <h2 id="faq">{heading}</h2>}
<div class="faq-inline">
  {faqs.map((f) => (
    <details class="faq__item">
      <summary class="faq__q"><span>{f.q}</span><span class="faq__icon" aria-hidden="true">+</span></summary>
      <div class="faq__a">{f.a}</div>
    </details>
  ))}
</div>

<style>
  .faq-inline { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .faq-inline .faq__item { background: #fff; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .faq-inline .faq__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; cursor: pointer; list-style: none; font-size: 15.5px; font-weight: 600; color: var(--text); }
  .faq-inline .faq__q::-webkit-details-marker { display: none; }
  .faq-inline .faq__icon { font-size: 20px; color: var(--success); flex-shrink: 0; transition: transform 0.2s; }
  .faq-inline .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq-inline .faq__a { padding: 0 22px 20px; font-size: 14.5px; line-height: 1.65; color: var(--text-2); }
</style>
