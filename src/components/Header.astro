---
import { NAV } from '../data/site.js';
---
<!-- Sticky ad banner -->
<div class="adbar">
  <div class="ad-slot adbar__slot">
    <span class="ad-label">[ Publicidad Patrocinada · 970×90 Ad Unit ]</span>
  </div>
</div>

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="EmprendeUS — inicio">
      <span class="brand__mark" aria-hidden="true">E</span>
      <span class="brand__name">EmprendeUS</span>
    </a>
    <nav class="nav" aria-label="Principal">
      {NAV.map((item) => (
        <a href={item.href} class="nav__link">{item.label}<span class="nav__caret" aria-hidden="true">▾</span></a>
      ))}
    </nav>
    <a href="/#comparador" class="header-cta">Comparador de LLCs</a>
    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .adbar {
    position: sticky; top: 0; z-index: 60;
    display: flex; justify-content: center;
    padding: 8px 16px; background: var(--bg-ad);
    border-bottom: 1px solid var(--border);
  }
  .adbar__slot { width: 100%; max-width: 970px; height: 72px; }

  .site-header {
    position: sticky; top: 89px; z-index: 55;
    background: rgba(250, 250, 248, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-2);
  }
  .site-header__inner {
    height: 68px; display: flex; align-items: center;
    justify-content: space-between; gap: 24px;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand__mark {
    width: 30px; height: 30px; border-radius: 8px; background: var(--bg-emerald);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--cta); font-family: var(--font-head); font-weight: 700; font-size: 17px;
  }
  .brand__name {
    font-family: var(--font-head); font-weight: 700; font-size: 21px;
    letter-spacing: -0.01em; color: var(--text);
  }
  .nav { display: flex; align-items: center; gap: 28px; }
  .nav__link {
    font-size: 14px; font-weight: 500; color: #384a45;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .nav__link:hover { color: var(--bg-emerald); }
  .nav__caret { font-size: 9px; color: #a8b0ac; }

  .header-cta {
    font-size: 14px; font-weight: 600; color: var(--bg-emerald);
    background: var(--soft-bg); border: 1px solid var(--soft-border);
    padding: 9px 18px; border-radius: 10px; white-space: nowrap;
    transition: background 0.18s ease;
  }
  .header-cta:hover { background: #c9f0d8; color: var(--bg-emerald); }

  .nav-toggle {
    display: none; flex-direction: column; gap: 4px;
    background: none; border: none; cursor: pointer; padding: 6px;
  }
  .nav-toggle span { width: 22px; height: 2px; background: var(--text); border-radius: 2px; }

  @media (max-width: 860px) {
    .nav, .header-cta { display: none; }
    .nav-toggle { display: flex; }
    .site-header { top: 89px; }
    .nav.is-open {
      display: flex; flex-direction: column; align-items: flex-start;
      position: absolute; top: 68px; left: 0; right: 0;
      background: var(--bg-page); padding: 16px var(--pad); gap: 16px;
      border-bottom: 1px solid var(--border-2);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
