---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site.js';
import { STATES_DATA } from '../../data/states.js';
import { STATE_MATCHUPS, SERVICES, SERVICE_MATCHUPS } from '../../data/comparisons.js';
import { breadcrumbSchema } from '../../data/seo.js';

const meta = {
  title: 'Comparativas: estados y servicios para tu LLC (2026)',
  description: 'Comparativas directas para decidir tu LLC en EE. UU.: Wyoming vs Nuevo México, Florida vs Wyoming, doola vs Globalfy y más. Datos verificados 2026.',
};
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const schemas = [breadcrumbSchema([{ name: 'Inicio', url: SITE.url }, { name: 'Comparativas', url: canonical }])];
---
<BaseLayout title={meta.title} description={meta.description} jsonld={schemas}>
  <Header />
  <main id="contenido" class="container comp">
    <nav class="crumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> <span aria-hidden="true">›</span>
      <span class="crumbs__current">Comparativas</span>
    </nav>
    <header class="comp__head">
      <span class="eyebrow">Comparativas directas</span>
      <h1 class="comp__title">Comparativas para decidir sin dudar</h1>
      <p class="comp__lead">Ponemos las opciones frente a frente —estado contra estado y servicio contra servicio— con datos verificados y un veredicto honesto para tu caso de no residente.</p>
    </header>

    <section class="comp__section">
      <h2 class="comp__h2">Estado vs estado</h2>
      <div class="comp__grid">
        {STATE_MATCHUPS.map((m) => (
          <a href={`/comparativas/${m.slug}`} class="comp__card">
            <span class="tag">Estados</span>
            <h3>LLC en {STATES_DATA[m.a].name} vs {STATES_DATA[m.b].name}</h3>
            <p>{m.angle}</p>
            <span class="comp__link">Ver comparativa →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="comp__section">
      <h2 class="comp__h2">Servicio vs servicio</h2>
      <div class="comp__grid">
        {SERVICE_MATCHUPS.map((m) => (
          <a href={`/comparativas/servicios/${m.slug}`} class="comp__card">
            <span class="tag">Servicios</span>
            <h3>{SERVICES[m.a].name} vs {SERVICES[m.b].name}</h3>
            <p>{m.angle}</p>
            <span class="comp__link">Ver comparativa →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .comp { padding: 40px 32px 72px; }
  .crumbs { font-size: 13px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
  .crumbs a { color: var(--text-3); }
  .crumbs__current { color: var(--text); }
  .comp__head { max-width: 720px; margin-bottom: 44px; }
  .comp__title { font-weight: 800; font-size: 44px; line-height: 1.08; letter-spacing: -0.02em; margin: 12px 0 16px; text-wrap: balance; }
  .comp__lead { font-size: 17.5px; line-height: 1.6; color: var(--text-2); margin: 0; }
  .comp__section { margin-bottom: 48px; }
  .comp__h2 { font-weight: 700; font-size: 26px; margin: 0 0 20px; }
  .comp__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .comp__card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px 26px; display: flex; flex-direction: column; gap: 10px; transition: transform 0.2s, box-shadow 0.2s; }
  .comp__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -20px rgba(10, 25, 15, 0.22); border-color: var(--cta); }
  .tag { align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--badge-text); background: var(--badge-bg); padding: 4px 10px; border-radius: 6px; }
  .comp__card h3 { font-size: 20px; line-height: 1.25; margin: 4px 0 0; color: var(--text); }
  .comp__card p { font-size: 14.5px; line-height: 1.55; color: var(--text-2); margin: 0; }
  .comp__link { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--bg-emerald); padding-top: 6px; }
  @media (max-width: 560px) { .comp__title { font-size: 32px; } }
</style>
