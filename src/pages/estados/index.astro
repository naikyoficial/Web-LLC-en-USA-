---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../data/site.js';
import { statesArray, firstYearCost, money, topStatesForNonResidents } from '../../data/states.js';

const states = statesArray().sort((a, b) => a.name.localeCompare(b.name, 'es'));
const top = topStatesForNonResidents(4);

const meta = {
  title: 'LLC por estado: compara los 50 estados de EE. UU. (2026)',
  description: 'Tabla comparativa de los 50 estados para abrir tu LLC como no residente: tarifa de registro, reporte anual, impuestos, privacidad y cuál te conviene. Datos verificados 2026.',
};
const canonical = new URL(Astro.url.pathname, SITE.url).href;

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Crear LLC por Estado', item: canonical },
  ],
};
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'LLC por estado en EE. UU.',
  itemListElement: states.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: `LLC en ${s.name}`, url: `${SITE.url}/estados/${s.slug}` })),
};
---
<BaseLayout title={meta.title} description={meta.description} jsonld={[breadcrumbSchema, itemListSchema]}>
  <Header />
  <main id="contenido" class="container est">
    <nav class="crumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a> <span aria-hidden="true">›</span>
      <span class="crumbs__current">Crear LLC por Estado</span>
    </nav>

    <header class="est__head">
      <span class="eyebrow">Comparativa de los 50 estados</span>
      <h1 class="est__title">¿En qué estado abrir tu LLC? Compara los 50</h1>
      <p class="est__lead">
        No existe un «mejor estado» universal: depende de tu costo objetivo, tu privacidad y de si operás
        físicamente en EE. UU. Esta tabla reúne las tarifas oficiales verificadas de los 50 estados para
        que decidas con datos. Hacé clic en cualquier estado para ver su guía completa.
      </p>
    </header>

    <section class="est__top">
      <h2 class="est__h2">Los 4 mejores estados para no residentes</h2>
      <div class="est__cards">
        {top.map((s) => (
          <a href={`/estados/${s.slug}`} class="est__card">
            <div class="est__card-name">{s.name}</div>
            <div class="est__card-price">{money(s.filing)} <span>registro</span></div>
            <div class="est__card-meta">{s.annualFreq === 'ninguno' ? 'Sin reporte anual' : `Anual: ${money(s.annual)}`} · Privacidad {s.privacy}</div>
            <span class="est__card-link">Ver guía →</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="est__h2">Tabla comparativa completa</h2>
      <p class="est__hint">Hacé clic en los encabezados para ordenar la tabla.</p>
      <div class="est__table-wrap">
        <table class="est__table" data-sortable>
          <thead>
            <tr>
              <th data-sort="name" data-type="text">Estado</th>
              <th data-sort="filing" data-type="num">Registro</th>
              <th data-sort="annual" data-type="num">Anual</th>
              <th data-sort="income" data-type="text">Imp. renta</th>
              <th data-sort="privacy" data-type="text">Privacidad</th>
              <th data-sort="score" data-type="num">Para no residentes</th>
            </tr>
          </thead>
          <tbody>
            {states.map((s) => (
              <tr>
                <td data-v-name={s.name}><a href={`/estados/${s.slug}`}>{s.name}</a></td>
                <td data-v-filing={s.filing}>{money(s.filing)}</td>
                <td data-v-annual={s.annual}>{s.annualFreq === 'ninguno' ? '—' : money(s.annual)}</td>
                <td data-v-income={s.incomeTax ? 1 : 0}>{s.incomeTax ? 'Sí' : 'No'}</td>
                <td data-v-privacy={s.privacy} style="text-transform:capitalize">{s.privacy}</td>
                <td data-v-score={s.score}><span class={`score score--${s.score}`}>{'★'.repeat(s.score)}<span class="score__dim">{'★'.repeat(5 - s.score)}</span></span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="est__disclaimer">Tarifas referenciales verificadas jul 2026. Las reglas y montos de cada estado cambian; confirmá siempre en la Secretaría de Estado correspondiente (enlazada en cada guía) antes de decidir.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .est { padding: 40px 32px 72px; }
  .crumbs { font-size: 13px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
  .crumbs a { color: var(--text-3); }
  .crumbs__current { color: var(--text); }
  .est__head { max-width: 760px; margin-bottom: 48px; }
  .est__title { font-weight: 800; font-size: 44px; line-height: 1.08; letter-spacing: -0.02em; margin: 12px 0 16px; text-wrap: balance; }
  .est__lead { font-size: 17.5px; line-height: 1.6; color: var(--text-2); margin: 0; }
  .est__h2 { font-weight: 700; font-size: 26px; margin: 0 0 18px; }
  .est__top { margin-bottom: 56px; }
  .est__cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .est__card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 22px; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; gap: 6px; }
  .est__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -20px rgba(10, 25, 15, 0.22); border-color: var(--cta); }
  .est__card-name { font-family: var(--font-head); font-weight: 700; font-size: 20px; color: var(--text); }
  .est__card-price { font-family: var(--font-head); font-weight: 700; font-size: 24px; color: var(--bg-emerald); }
  .est__card-price span { font-family: var(--font-body); font-size: 13px; font-weight: 400; color: var(--text-3); }
  .est__card-meta { font-size: 13px; color: var(--text-3); }
  .est__card-link { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--bg-emerald); padding-top: 8px; }

  .est__hint { font-size: 14px; color: var(--text-3); margin: 0 0 14px; }
  .est__table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 14px; }
  .est__table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 640px; }
  .est__table th, .est__table td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .est__table thead th { background: var(--bg-neutral); font-weight: 600; cursor: pointer; user-select: none; position: relative; }
  .est__table thead th:hover { color: var(--bg-emerald); }
  .est__table tbody tr:hover { background: #f8f8f5; }
  .est__table a { color: var(--bg-emerald); font-weight: 600; }
  .score { color: var(--star); letter-spacing: 1px; font-size: 13px; }
  .score__dim { color: #e0ded6; }
  .est__disclaimer { font-family: var(--font-mono); font-size: 11px; color: var(--text-3); margin: 18px 0 0; line-height: 1.6; }

  @media (max-width: 900px) {
    .est__cards { grid-template-columns: 1fr 1fr; }
    .est__title { font-size: 32px; }
  }
  @media (max-width: 520px) {
    .est__cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  const table = document.querySelector('[data-sortable]');
  if (table) {
    const tbody = table.querySelector('tbody');
    const headers = table.querySelectorAll('th[data-sort]');
    let asc = {};
    headers.forEach((th) => {
      th.addEventListener('click', () => {
        const key = th.dataset.sort;
        const type = th.dataset.type;
        asc[key] = !asc[key];
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort((a, b) => {
          const av = a.querySelector(`[data-v-${key}]`).getAttribute(`data-v-${key}`);
          const bv = b.querySelector(`[data-v-${key}]`).getAttribute(`data-v-${key}`);
          const cmp = type === 'num' ? Number(av) - Number(bv) : String(av).localeCompare(String(bv), 'es');
          return asc[key] ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  }
</script>
