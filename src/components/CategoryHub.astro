---
// Contenido de hub de categoría (presentacional). El layout, Header/Footer y
// los schemas los provee la página que lo usa.
const { eyebrow, title, lead, crumb, cards = [] } = Astro.props;
---
<div class="container hubpage">
  <nav class="crumbs" aria-label="Ruta de navegación">
    <a href="/">Inicio</a> <span aria-hidden="true">›</span>
    <span class="crumbs__current">{crumb}</span>
  </nav>
  <header class="hubpage__head">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="hubpage__title">{title}</h1>
    <p class="hubpage__lead">{lead}</p>
  </header>
  <div class="hubpage__grid">
    {cards.map((c) => (
      <a href={c.href} class="hubpage__card">
        <span class="tag">{c.tag}</span>
        <h2 class="hubpage__card-title">{c.title}</h2>
        <p class="hubpage__card-desc">{c.desc}</p>
        <span class="hubpage__card-link">Leer guía →</span>
      </a>
    ))}
  </div>
  <slot />
</div>

<style>
  .hubpage { padding: 40px 32px 72px; }
  .crumbs { font-size: 13px; color: var(--text-3); margin-bottom: 20px; display: flex; gap: 8px; align-items: center; }
  .crumbs a { color: var(--text-3); }
  .crumbs__current { color: var(--text); }
  .hubpage__head { max-width: 720px; margin-bottom: 44px; }
  .hubpage__title { font-weight: 800; font-size: 44px; line-height: 1.08; letter-spacing: -0.02em; margin: 12px 0 16px; text-wrap: balance; }
  .hubpage__lead { font-size: 17.5px; line-height: 1.6; color: var(--text-2); margin: 0; }
  .hubpage__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .hubpage__card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px 26px; display: flex; flex-direction: column; gap: 10px; transition: transform 0.2s, box-shadow 0.2s; }
  .hubpage__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -20px rgba(10, 25, 15, 0.22); border-color: var(--cta); }
  .tag { align-self: flex-start; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--badge-text); background: var(--badge-bg); padding: 4px 10px; border-radius: 6px; }
  .hubpage__card-title { font-size: 21px; line-height: 1.25; margin: 4px 0 0; color: var(--text); }
  .hubpage__card-desc { font-size: 14.5px; line-height: 1.55; color: var(--text-2); margin: 0; }
  .hubpage__card-link { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--bg-emerald); padding-top: 6px; }
  @media (max-width: 560px) { .hubpage__title { font-size: 32px; } }
</style>
